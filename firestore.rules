rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    function validQuantity(items, itemId) {
      return !items.keys().hasAny([itemId])
        || (items[itemId] is int && items[itemId] >= 1 && items[itemId] <= 20);
    }

    function validItems(items) {
      return items is map
        && items.keys().size() > 0
        && items.keys().hasOnly(['classic', 'masala', 'cheese', 'paneer', 'mushroom', 'chicken'])
        && validQuantity(items, 'classic')
        && validQuantity(items, 'masala')
        && validQuantity(items, 'cheese')
        && validQuantity(items, 'paneer')
        && validQuantity(items, 'mushroom')
        && validQuantity(items, 'chicken');
    }

    function expectedSubtotal(items) {
      return items.get('classic', 0) * 14900
        + items.get('masala', 0) * 17900
        + items.get('cheese', 0) * 19900
        + items.get('paneer', 0) * 22900
        + items.get('mushroom', 0) * 21900
        + items.get('chicken', 0) * 24900;
    }

    function validOrder() {
      let data = request.resource.data;
      return signedIn()
        && data.keys().hasAll(['ownerUid', 'customerName', 'phone', 'address', 'notes', 'items', 'subtotal', 'status', 'createdAt'])
        && data.keys().hasOnly(['ownerUid', 'customerName', 'phone', 'address', 'notes', 'items', 'subtotal', 'status', 'createdAt'])
        && data.ownerUid == request.auth.uid
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 20
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 300
        && data.notes is string && data.notes.size() <= 300
        && validItems(data.items)
        && data.subtotal is int && data.subtotal == expectedSubtotal(data.items)
        && data.status == 'received'
        && data.createdAt == request.time;
    }

    match /admins/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if validOrder();
      allow get, list: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['received', 'preparing', 'ready', 'completed', 'cancelled'];
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
